{
    // Astro
    "astro.updateImportsOnFileMove.enabled": true,
  
    // Code Spell Checker
    "cSpell.userWords": [
      "ampscript",
      "aperitivo",
      "apothic",
      "arcsize",
      "arial",
      "astro",
      "bgcolor",
      "bspace",
      "busname",
      "caitlen",
      "cellpadding",
      "cellspacing",
      "checkmark",
      "codesnippetblock",
      "concat",
      "degdigital",
      "Drizly",
      "eacute",
      "emailaddr",
      "euml",
      "extracss",
      "frontmatter",
      "Fruitscato",
      "gmail",
      "gradientfill",
      "Grigio",
      "grizz",
      "grizzlemail",
      "gsub",
      "gulpfile",
      "helvetica",
      "Instacart",
      "itemprop",
      "itemscope",
      "itemtype",
      "lspace",
      "malbec",
      "marca",
      "monospace",
      "moscato",
      "mso",
      "museo",
      "nbsp",
      "nowrap",
      "oneasics",
      "OOTB",
      "opencounter",
      "optin",
      "overcomplicating",
      "pardot",
      "pcss",
      "pinterest",
      "precss",
      "preheader",
      "prosecco",
      "Proseccos",
      "roboto",
      "roundrect",
      "rspace",
      "runat",
      "samsungfix",
      "sauvignon",
      "sfmc",
      "smsb",
      "stoplist",
      "strokecolor",
      "strokeweight",
      "stylelint",
      "stylesheet",
      "stylesheets",
      "templating",
      "textbox",
      "textfill",
      "tsconfigs",
      "tspace",
      "unsub",
      "valign",
      "vawp",
      "Viarae",
      "webmail",
      "websafe",
      "Whitehaven",
      "wordmark",
      "xmlns",
      "youtube",
      "zwnj"
    ],
  
    // CSS lint
    "css.customData": ["/Users/Christopher.Smith@ejgallo.com/Library/Application Support/Code/User/custom-data/css-custom-data.json"],
    "scss.customData": ["/Users/Christopher.Smith@ejgallo.com/Library/Application Support/Code/User/custom-data/css-custom-data.json"],
    "css.lint.duplicateProperties": "warning",
    "css.lint.validProperties": [
    "mso-ansi-font-size",
    "mso-border-alt",
    "mso-color-alt",
    "mso-font-width",
    "mso-line-height-alt",
    "mso-line-height-rule",
    "mso-hide",
    "mso-margin-bottom-alt",
    "mso-margin-left-alt",
    "mso-margin-right-alt",
    "mso-margin-top-alt",
    "mso-padding-alt",
    "mso-special-format",
    "mso-table-bspace",
    "mso-table-lspace",
    "mso-table-rspace",
    "mso-table-tspace",
    "text-underline-color",
    "mso-text-raise",
    "mso-width-alt"
  ],

    // CSS Stylelint
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    },
    "stylelint.validate": [
      "css",
      "scss",
      "astro"
    ],
    
    // Editor Settings
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "block",
    "editor.cursorWidth": 5,
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.fontFamily": "'cascadia code'",
    "editor.fontLigatures": true,
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.guides.bracketPairs": "active",
    "editor.hover.enabled": "on",
    "editor.lineHeight": 24,
    "editor.linkedEditing": true,
    "editor.minimap.maxColumn": 50,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.padding.top": 35,
    "editor.quickSuggestionsDelay": 100,
    "editor.unusualLineTerminators": "auto",
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
  
    // Emmet
    "emmet.excludeLanguages": [],
    "emmet.includeLanguages": {"yaml": "html"},
    "emmet.triggerExpansionOnTab": true,
  
    // ERB
    "[erb]": {
      "editor.language.brackets": [
        ["%%[", "]%%"],
        ["<%", "%>"]
      ],
      "editor.language.colorizedBracketPairs": [
        ["%%[", "]%%"],
        ["<%", "%>"]
      ]
    },
  
    // Explorer
    "breadcrumbs.enabled": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.decorations.badges": false,
  
    // File associations
    "files.associations": {
      "*.amp.html": "ampscript",
      "*.amp.astro": "ampscript",
      "*.astro": "astro",
      "*.erb": "erb",
      "**/build/content/handlebars-files/**/*.html": "handlebars",
      "templateChooser.html": "handlebars",
      "*.html": "html",
      "*.mdx": "mdx",
      "*.scss.erb": "scss",
      "*.sublime-snippet": "xml"
    },
  
    // Files to exclude from Explorer view
    "files.exclude": {
      "**/_gem-resources": true,
      "**/_helpers.rb": true,
      "**/.sass-cache": true,
      "**/config.rb": true,
      "**/Gemfile": true,
      "**/Gemfile.lock": true,
      "**/Rakefile": true
    },
  
    // Git
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "always",
    "scm.alwaysShowRepositories": true,
    
    // Git Lens
    "gitlens.defaultDateFormat": "YYYY-MM-DD",
    "gitlens.hovers.currentLine.over": "line",
  
    // HTML formatting
    "html.format.indentInnerHtml": true,
    "html.format.preserveNewLines": false,
    "html.format.wrapLineLength": 1000,
    "html.format.wrapAttributes": "auto",
  
    // HTML Hint
    "htmlhint.options": {
      "doctype-first": false
    },

    // HTTP
    "http.proxySupport": "off",
    "http.proxyStrictSSL": false,
    "http.systemCertificates": false,
  
    // JavaScript
    "javascript.updateImportsOnFileMove.enabled": "always",
  
    // Live Server
    "liveServer.settings.CustomBrowser": "firefox", // Update to your fav
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.donotVerifyTags": true,
  
    // Prettier
    "[astro]": {
      "editor.defaultFormatter": "astro-build.astro-vscode",
      "editor.formatOnSave": true,
      "editor.language.brackets": [
        ["%%[", "]%%"],
        ["<%", "%>"]
      ],
      "editor.language.colorizedBracketPairs": [
        ["%%[", "]%%"],
        ["<%", "%>"]
      ]
    },
  
    // Project Manager
    "projectManager.git.baseFolders": [
      "~\\AppData\\Roaming\\Code\\User",
      "c:\\\\repos",
      "$home\\repos",
      "$home\\Library\\Application Support\\Code\\User",
      "e:\\\\repos",
      "$home\\Dev"
    ],
  
    // SCSS lint
    "scss.lint.validProperties": [
      "mso-border-alt",
      "mso-font-alt",
      "mso-font-width",
      "mso-line-height-alt",
      "mso-line-height-rule",
      "mso-hide",
      "mso-margin-bottom-alt",
      "mso-margin-left-alt",
      "mso-margin-right-alt",
      "mso-margin-top-alt",
      "mso-padding-alt",
      "mso-special-format",
      "mso-table-bspace",
      "mso-table-lspace",
      "mso-table-rspace",
      "mso-table-tspace",
      "mso-text-raise",
      "mso-width-alt"
    ],
  
    // Terminal
    "terminal.external.osxExec": "/opt/homebrew/Cellar/bash/5.2.37/bin/bash",
    "terminal.integrated.defaultProfile.osx": "bash",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.fontSize": 11,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.smoothScrolling": true,
    "window.openFilesInNewWindow": "on",
    "window.title": "${activeEditorShort}${separator}${rootPath}",
    "window.commandCenter": true,

    // Typescript
    "typescript.inlayHints.parameterNames.enabled": "all",
    "typescript.preferences.quoteStyle": "double",
  
    // Workbench customizations
    "workbench.activityBar.location": "top",
    "workbench.colorCustomizations": {
      // Mostly color updates to make things stand out
      // Optimized for use with the Moonlight theme
      "activityBar.background": "#050d0f",
      "editorBracketHighlight.foreground1": "#DA70D6",
      "editorBracketHighlight.foreground2": "#ffbf00",
      "editorBracketHighlight.foreground3": "#179fff",
      "editorError.foreground": "#f954ff",
      "editorGroup.border": "#00bfff3e",
      "editorInfo.foreground": "#a2ff00",
      "editorInfo.border": "#a2ff00",
      "editorStickyScroll.background": "#050d0f",
      "editorStickyScrollHover.background": "#0f191b",
      "sideBar.background": "#050d0f",
      "statusBar.background": "#050d0f",
      "statusBar.foreground": "#00bfff",
      "panel.background": "#050d0f"
    },
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.scrollToSwitchTabs": true,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.panel.defaultLocation": "right",
    "workbench.sideBar.location": "right",
    "workbench.tree.enableStickyScroll": true,
    "terminal.integrated.env.osx": {},
    "console-ninja.featureSet": "Community",
    "[css]": {
      "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features"
    },
    "console-ninja.toolsToEnableSupportAutomaticallyFor": {
      "live-server-extension": true
    },
    "editor.defaultColorDecorators": "never",
    "workbench.colorTheme": "Moonlight II",
    "chat.agent.enabled": false,
    "[javascript]": {
      "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "chat.viewSessions.orientation": "stacked"
  }